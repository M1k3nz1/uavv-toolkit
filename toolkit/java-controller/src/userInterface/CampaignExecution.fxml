<AnchorPane fx:id="apExecutionPage" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="700.0" minWidth="850.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="userInterface.CampaignExecutionController" styleClass="page">
   <children>
      <VBox alignment="TOP_CENTER" minHeight="559.0" minWidth="850.0" prefHeight="700.0" prefWidth="850.0" spacing="30.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <Text fx:id="tlTitle" strokeType="OUTSIDE" strokeWidth="0.0" text="Campaign Execution" styleClass="t-h1">
            </Text>
            <HBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="26.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="51.0" prefWidth="810.0" spacing="10.0">
                     <children>
                        <Text fx:id="tlExperimentName" strokeType="OUTSIDE" strokeWidth="0.0" text="Campaign Name" styleClass="t-plain">
                        </Text>
                     </children></HBox>
                  <HBox alignment="CENTER_RIGHT" prefHeight="51.0" prefWidth="810.0" spacing="10.0">
                     <children>
                        <ComboBox fx:id="cbExecuteOn" prefHeight="42.0" prefWidth="171.0" promptText="Execute Mision on" />
                        <Button fx:id="btnPlay" mnemonicParsing="false" onMouseClicked="#onClickBtnPlay" text="PLAY" minWidth="110.0" styleClass="btn-primary">
                           <padding>
                              <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
                           </padding>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </HBox>
            <TextArea fx:id="tfLogWindow" editable="false" prefHeight="527.0" prefWidth="810.0">
            </TextArea>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
      </VBox>
   </children>
</AnchorPane>
