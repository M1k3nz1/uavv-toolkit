+void log_distance2(double distance, double radius,
+                  double drone_lat, double drone_lon,
+                  double fault_lat, double fault_lon)
+{
+  const char *log_file_path = "/opt/uavv/logs/faultlog/log.txt";
+  
+  FILE *file = fopen(log_file_path, "a");
+  if (file) {
+    fprintf(file, "%.2f,%.2f,%.7f,%.7f,%.7f,%.7f\n",
+            distance, radius,
+            drone_lat, drone_lon,
+            fault_lat, fault_lon);
+    fclose(file);
+  } else {
+    PX4_ERR("Failed to open distance log file.");
+  }
+}
